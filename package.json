{
  "name": "rontenseiri",
  "private": true,
  "version": "0.1.0-prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config=playwright.offline.config.ts",
    "test:performance:controlled": "node scripts/controlled-performance.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts evals/cases.json artifacts/evaluation-empty.json artifacts/evaluation-empty.md",
    "format": "prettier --write src tests e2e scripts public *.ts *.json .github/workflows/ci.yml",
    "check:format": "prettier --check src tests e2e scripts public *.ts *.json .github/workflows/ci.yml"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@xmldom/xmldom": "^0.9.12",
    "@xyflow/react": "12.12.0",
    "fflate": "^0.8.3",
    "idb": "8.0.3",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.18"
  }
}
